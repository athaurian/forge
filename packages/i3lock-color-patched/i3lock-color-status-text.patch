 /*
+ * Multiplies the background colors by a per-pixel vignette factor, matching
+ * swaylock-effects' effect_vignette.
+ */
+static void apply_vignette(cairo_surface_t *surface) {
+    if (vignette_base >= 1.0 && vignette_factor <= 0.0)
+        return;
+
+    cairo_surface_flush(surface);
+    int width = cairo_image_surface_get_width(surface);
+    int height = cairo_image_surface_get_height(surface);
+    int stride = cairo_image_surface_get_stride(surface);
+    unsigned char *data = cairo_image_surface_get_data(surface);
+
+    for (int y = 0; y < height; ++y) {
+        double yf = (double)y / height;
+        for (int x = 0; x < width; ++x) {
+            double xf = (double)x / width;
+            double factor = vignette_base +
+                            vignette_factor * 16 * xf * yf * (1.0 - xf) * (1.0 - yf);
+            unsigned char *pixel = data + y * stride + x * 4;
+            pixel[0] = (unsigned char)(pixel[0] * factor);
+            pixel[1] = (unsigned char)(pixel[1] * factor);
+            pixel[2] = (unsigned char)(pixel[2] * factor);
+        }
+    }
+
+    cairo_surface_mark_dirty(surface);
+}
